                <VBox class="fbl5nMainWorkspace">
                    
                    <!-- Selection Criteria Panel -->
                    <Panel id="filterPanel" expandable="true" expanded="true" class="fbl5nFilterPanel">
                        <headerToolbar>
                            <Toolbar class="fbl5nFilterToolbar">
                                <core:Icon src="sap-icon://sys-find" class="fbl5nFilterIcon" />
                                <Title text="Selection Criteria (SAP FBL5N Input Parameters)" class="fbl5nFilterTitle" />
                            </Toolbar>
                        </headerToolbar>
                        <content>
                            <VBox class="fbl5nFilterContent">
                                <l:Grid defaultSpan="XL4 L4 M6 S12" vSpacing="1" hSpacing="1">
                                    <VBox>
                                        <Label text="Company Code *" class="fbl5nFilterLabel" />
                                        <Input id="inCompanyCode" value="{ui>/filter/companyCode}" showValueHelp="true" valueHelpRequest=".onCompanyCodeValueHelp" placeholder="0125" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Customer Account *" class="fbl5nFilterLabel" />
                                        <Input id="inCustomer" value="{ui>/filter/customer}" showValueHelp="true" valueHelpRequest=".onCustomerValueHelp" placeholder="e.g. 1000492" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Line Item Selection Type" class="fbl5nFilterLabel" />
                                        <SegmentedButton selectedKey="{ui>/filter/mode}" width="100%" selectionChange=".onFilterChange">
                                            <items>
                                                <SegmentedButtonItem key="Open" text="Open Items" />
                                                <SegmentedButtonItem key="Cleared" text="Cleared Items" />
                                                <SegmentedButtonItem key="All" text="All Items" />
                                            </items>
                                        </SegmentedButton>
                                    </VBox>
                                </l:Grid>

