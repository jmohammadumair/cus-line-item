<mvc:View
    controllerName="dashboard.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    displayBlock="true">

    <Page id="page" showHeader="true" title="Customer Line Item Display (FBL5N)" class="sapUiNoContentPadding fbl5nPage">
        
        <dependents>
            <Dialog id="postDialog" title="Simulate SAP Customer Ledger Posting (FB01)" class="fbl5nPostDialog" contentWidth="450px">
                <content>
                    <l:Grid defaultSpan="L6 M6 S12" vSpacing="0" hSpacing="1" class="sapUiSmallMargin">
                        <VBox>
                            <Label text="Company Code" />
                            <Input value="{postModel>/CompanyCode}" />
                        </VBox>
                        <VBox>
                            <Label text="Customer Account" />
                            <Select selectedKey="{postModel>/Customer}" items="{customers>/}" width="100%">
                                <core:Item key="{customers>id}" text="{customers>id} - {customers>name}" />
                            </Select>
                        </VBox>
                        <VBox>
                            <Label text="Document Date" />
                            <DatePicker value="{postModel>/DocumentDate}" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" />
                        </VBox>
                        <VBox>
                            <Label text="Posting Date" />
                            <DatePicker value="{postModel>/PostingDate}" valueFormat="yyyy-MM-dd" displayFormat="yyyy-MM-dd" />
                        </VBox>
                        <VBox>
                            <Label text="Amount (INR) - Negative represents Credit" />
                            <Input value="{postModel>/AmountInCompanyCodeCurrency}" type="Number" />
                        </VBox>
                        <VBox>
                            <Label text="Billing Doc Type" />
                            <Input value="{postModel>/BillingDocumentType}" />
                        </VBox>
                        <VBox>
                            <Label text="Tax Code" />
                            <Select selectedKey="{postModel>/TaxCode}" width="100%">
                                <core:Item key="S1" text="S1 - Domestic Standard Tax (18%)" />
                                <core:Item key="S2" text="S2 - Domestic Reduced Tax (5%)" />
                                <core:Item key="S0" text="S0 - Tax Free Export Item" />
                            </Select>
                        </VBox>
                        <VBox>
                            <Label text="Initial Status" />
                            <Select selectedKey="{postModel>/Status}" width="100%">
                                <core:Item key="Open" text="Open (Pending Clearance)" />
                                <core:Item key="Cleared" text="Cleared (Already Settled)" />
                            </Select>
                        </VBox>
                    </l:Grid>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Document Allocation Text" />
                        <Input value="{postModel>/DocumentItemText}" placeholder="e.g. Cleared payment via domestic bank transfer" />
                    </VBox>
                </content>
                <buttons>
                    <Button text="Post Document (FB01)" type="Emphasized" press=".onSubmitPost" />
                    <Button text="Cancel" press=".onCancelPost" />
                </buttons>
            </Dialog>
        </dependents>

