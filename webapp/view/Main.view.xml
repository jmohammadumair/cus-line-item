        <!-- System Notification Banner -->
        <VBox visible="{= ${ui>/notifications}.length > 0 }" class="fbl5nNotificationBanner">
            <HBox alignItems="Center" justifyContent="SpaceBetween" class="fbl5nNotificationInner">
                <HBox alignItems="Center">
                    <core:Icon src="sap-icon://lightbulb" class="fbl5nNotifIcon" />
                    <Text text="Fiori System Notification:" class="fbl5nNotifTitle" />
                    <Text text="{ui>/notifications/0}" class="fbl5nNotifText" />
                </HBox>
                <Button text="Dismiss" type="Transparent" press=".onClearNotifications" class="fbl5nNotifDismissBtn" />
            </HBox>
        </VBox>

        <!-- Main Layout with Dynamic Side Content for CoPilot -->
        <!--
        <l:DynamicSideContent
            id="DynamicSideContent"
            class="sapUiDSC"
            sideContentFallDown="BelowM"
