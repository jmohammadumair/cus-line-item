                    <!-- KPI Cards Section -->
                    <l:Grid defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMarginTop">
                        <!-- Open Balance -->
                        <VBox class="fbl5nKpiCard card-red">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <Title text="OPEN BALANCE" class="fbl5nKpiTitle" />
                                <Label text="Unpaid" class="fbl5nKpiBadge badge-red" />
                            </HBox>
                            <HBox alignItems="Baseline" class="sapUiSmallMarginTop">
                                <Title text="{ui>/kpi/openBalanceFormatted}" class="fbl5nKpiValue" />
                                <Text text="INR" class="fbl5nKpiCurrency" />
                            </HBox>
                            <HBox alignItems="Center" class="fbl5nKpiFooter sapUiSmallMarginTop">
                                <core:Icon src="sap-icon://sys-cancel-2" color="red" />
                                <Text text="Active pending legal collections" class="sapUiTinyMarginBegin" />
                            </HBox>
                        </VBox>

                        <!-- Cleared Balance -->
                        <VBox class="fbl5nKpiCard card-green">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <Title text="CLEARED BALANCE" class="fbl5nKpiTitle" />
                                <Label text="Settled" class="fbl5nKpiBadge badge-green" />
                            </HBox>
                            <HBox alignItems="Baseline" class="sapUiSmallMarginTop">
                                <Title text="{ui>/kpi/clearedBalanceFormatted}" class="fbl5nKpiValue" />
                                <Text text="INR" class="fbl5nKpiCurrency" />
                            </HBox>
                            <HBox alignItems="Center" class="fbl5nKpiFooter sapUiSmallMarginTop">
                                <core:Icon src="sap-icon://sys-enter-2" color="green" />
                                <Text text="Processed ledger settlements" class="sapUiTinyMarginBegin" />
                            </HBox>
                        </VBox>

                        <!-- Net Exposure -->
                        <VBox class="fbl5nKpiCard card-blue">
                            <HBox justifyContent="SpaceBetween" alignItems="Center">
                                <Title text="NET EXPOSURE" class="fbl5nKpiTitle" />
                                <Label text="Summary" class="fbl5nKpiBadge badge-blue" />
                            </HBox>
                            <HBox alignItems="Baseline" class="sapUiSmallMarginTop">
                                <Title text="{ui>/kpi/netExposureFormatted}" class="fbl5nKpiValue" />
                                <Text text="INR" class="fbl5nKpiCurrency" />
                            </HBox>
                            <HBox alignItems="Center" class="fbl5nKpiFooter sapUiSmallMarginTop">
                                <core:Icon src="sap-icon://bar-chart" color="blue" />
                                <Text text="Combined customer balance state" class="sapUiTinyMarginBegin" />
                            </HBox>
                        </VBox>

                        <!-- Total Items -->
                        <VBox class="fbl5nKpiCard card-purple">
