                            <Button text="Post Simulated Doc" icon="sap-icon://add" press=".onOpenPostingModal" class="fbl5nPostBtn" />
                            <Button text="Export" icon="sap-icon://download" press=".onExportCSV" class="fbl5nExportBtn" />
                            <Button text="Reset DB" icon="sap-icon://refresh" press=".onResetDB" class="fbl5nResetDbBtn" />
                            -->
                        </OverflowToolbar>

                        <ScrollContainer width="100%" horizontal="true" vertical="false">
                            <Table 
                                id="lineItemsTable"
                                items="{ui>/tableData}"
                                mode="MultiSelect"
                                selectionChange=".onSelectionChange"
                                class="fbl5nTable">
                                <columns>
                                    <Column width="5rem" hAlign="Center"><Text text="Status" /></Column>
                                    <Column width="8rem"><Text text="Doc Number" /></Column>
                                    <Column width="6rem"><Text text="Type" /></Column>
                                    <Column width="9rem"><Text text="Posting Date" /></Column>
                                    <Column width="15rem">
                                        <Text text="Customer" />
                                        <footer>
                                            <HBox alignItems="Center" class="fbl5nSumLabelBox" visible="{= ${ui>/kpi/totalItems} > 0 }">
                                                <core:Icon src="sap-icon://sum" class="fbl5nSumIcon" />
                                                <Text text="SUM OF SELECTED &amp; ACTIVE ITEMS:" class="fbl5nSumLabel" />
                                            </HBox>
                                        </footer>
                                    </Column>
                                    <Column width="12rem" hAlign="End">
                                        <Text text="Amount in Currency" />
                                        <footer>
                                            <VBox alignItems="End" class="fbl5nSumValueBox" visible="{= ${ui>/kpi/totalItems} > 0 }">
                                                <Text text="{ui>/activeFilteredTotalFormatted}" 
                                                      class="{= ${ui>/activeFilteredTotal} &lt; 0 ? 'fbl5nSumValueRed' : 'fbl5nSumValue'}" />
                                                <Text text="INR" class="fbl5nSumCurrency" />
                                            </VBox>
                                        </footer>
                                    </Column>
                                    <Column width="4rem"><Text text="Tax" /></Column>
                                    <Column width="6rem"><Text text="Sales Org" /></Column>
                                    <Column width="10rem"><Text text="Cleared By Doc" /></Column>
                                    <Column width="12rem" hAlign="Center"><Text text="Actions" /></Column>
                                </columns>
                                <items>
                                    <ColumnListItem type="Active" press=".onItemPress">
                                        <cells>
                                            <core:Icon src="{path: 'ui>Status', formatter: '.formatter.statusIcon'}" color="{path: 'ui>Status', formatter: '.formatter.statusState'}" class="fbl5nStatusIcon" />
                                            <VBox>
                                                <Link text="{ui>AccountingDocument}" press=".onDocDetails" class="fbl5nDocLink" />
                                                <Text text="Yr: {ui>FiscalYear}" class="fbl5nDocSub" />
                                            </VBox>
                                            <VBox>
                                                <Label text="{= ${ui>BillingDocumentType} || 'RV' }" class="fbl5nTypeBadge" />
                                                <Text text="Line: {ui>LedgerGLLineItem}" class="fbl5nDocSub" />
                                            </VBox>
                                            <VBox>
                                                <Text text="{path: 'ui>PostingDate', formatter: '.formatter.formatDate'}" class="fbl5nDateText" />
                                                <Text text="Doc: {path: 'ui>DocumentDate', formatter: '.formatter.formatDate'}" class="fbl5nDocSub" />
                                            </VBox>
                                            <VBox>
                                                <Text text="{ui>Customer}" class="fbl5nCustomerText" />
                                                <Text text="{ui>CustomerName}" class="fbl5nCustomerName" />
                                            </VBox>
                                            <VBox alignItems="End">
                                                <Text text="{path: 'ui>AmountInCompanyCodeCurrency', formatter: '.formatter.formatAmount'}" 
                                                      class="{= ${ui>AmountInCompanyCodeCurrency} &lt; 0 ? 'fbl5nAmountRed' : 'fbl5nAmountBlack'}" />
                                                <Text text="{ui>CompanyCodeCurrency}" class="fbl5nCurrencySub" />
                                            </VBox>
                                            <Text text="{= ${ui>TaxCode} || 'S1' }" class="fbl5nTaxText" />
                                            <VBox>
                                                <Text text="{= ${ui>SalesOrganization} || '5206' }" class="fbl5nSalesText" />
                                                <Text text="Ch: {= ${ui>DistributionChannel} || 'Z1' }" class="fbl5nDocSub" />
                                            </VBox>
                                            <VBox visible="{= ${ui>Status} === 'Cleared' }">
                                                <Label text="{= ${ui>ClearingAccountingDocument} || '2000041' }" class="fbl5nClearingBadge" />
                                                <Text text="Date: {path: 'ui>ClearingDate', formatter: '.formatter.formatDate'}" class="fbl5nDocSub" />
                                            </VBox>
                                            <Text text="-" visible="{= ${ui>Status} !== 'Cleared' }" class="fbl5nMuted" />
                                            <HBox justifyContent="Center">
                                                <Button text="Details" press=".onDocDetails" class="fbl5nDetailsBtn sapUiTinyMarginEnd" />
                                                <Button text="Clear" press=".onClearInvoice" visible="{= ${ui>Status} === 'Open' }" class="fbl5nClearBtn" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </ScrollContainer>
                    </VBox>

                    <!-- Raw JSON Viewer -->
