                                <core:Icon src="sap-icon://energy" color="purple" />
                                <Text text="Showing dynamic client view" class="sapUiTinyMarginBegin" />
                            </HBox>
                        </VBox>
                    </l:Grid>

                    <!-- Main ALV Table -->
                    <VBox class="fbl5nTableWrapper sapUiSmallMarginTop">
                        <OverflowToolbar class="fbl5nTableToolbar">
                            <Title text="Customer Line Items Table Grid" class="fbl5nTableTitle" />
                            <Text text="({ui>/kpi/totalItems} records matches)" class="fbl5nTableSubTitle" />
                            <ToolbarSpacer />
                            <SearchField placeholder="Search Document, Type, Tax..." value="{ui>/search}" width="200px" search=".onSearch" liveChange=".onSearch" class="fbl5nSearchField" />
